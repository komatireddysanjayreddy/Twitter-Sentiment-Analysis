# Normalize all text files to LF on commit, checkout with OS line endings
* text=auto eol=lf

# Force LF for scripts and configs (so they work on Linux/Docker)
*.py   text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
