# Next.js local environment — copy this to .env.local and fill in values
# This file is safe to commit. .env.local is gitignored.

# ── Local development (Docker PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://sentiment_user:sentiment_pass@localhost:5432/sentiment_db

# ── Production (Vercel) — use a cloud PostgreSQL URL ─────────────────────────
# Get a free database at https://neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
