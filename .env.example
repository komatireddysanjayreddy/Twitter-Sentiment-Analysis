# ─── Twitter / X API ─────────────────────────────────────────────────────────
# Get your key from https://twitterapi.io
TWITTER_API_KEY=your_twitterapi_io_key_here

# Keywords to track (comma-separated, no spaces)
SEARCH_KEYWORDS=python,ai,technology,machinelearning

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=tweets

# Mock producer rate (tweets per second, for testing)
MOCK_RATE=1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentiment_db
POSTGRES_USER=sentiment_user
POSTGRES_PASSWORD=change_me_in_production

# ─── PySpark ─────────────────────────────────────────────────────────────────
CHECKPOINT_DIR=/tmp/spark-checkpoints/tweets
TRIGGER_INTERVAL=10 seconds

# ─── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# ─── Next.js Dashboard (Vercel) ───────────────────────────────────────────────
# Local development — matches Docker PostgreSQL above
DATABASE_URL=postgresql://sentiment_user:change_me_in_production@localhost:5432/sentiment_db

# Production — use a cloud PostgreSQL URL (Neon, Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:pass@your-cloud-host:5432/sentiment_db?sslmode=require
